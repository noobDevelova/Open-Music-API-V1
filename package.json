{
  "name": "open-api-music-v1",
  "version": "1.0.0",
  "description": "submission-dicoding-1",
  "main": "index.js",
  "scripts": {
    "start:prod": "NODE_ENV=production node ./src/server.js",
    "start:dev": "nodemon ./src/server.js",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "db:seed": "psql -U noobdev -d openmusicdb -f src/Infrastructure/database/seeds/seed.sql",
    "db:init": "npm run migrate:up && npm run db:seed"
  },
  "author": "Randi Risdiansyah",
  "license": "MIT",
  "dependencies": {
    "@hapi/hapi": "^21.4.0",
    "dotenv": "^16.4.7",
    "joi": "^17.13.3",
    "nanoid": "^3.1.20",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.26.10",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3"
  }
}
